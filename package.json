{
  "name": "wroclaw-pixel-map",
  "private": true,
  "version": "0.2.3",
  "description": "Interaktywna pikselowa mapa 3D Wrocławia z osią czasu, krasnalami i ciekawostkami",
  "repository": "github:okkindel/WroclawPixelMap",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "fetch": "node scripts/fetch/fetch-osm.ts",
    "bake": "node scripts/bake/bake.ts",
    "fetch-ortho": "node scripts/fetch/fetch-ortho.ts",
    "bake-plans": "node scripts/bake/export-water.ts && python3 scripts/bake/bake-plans.py",
    "fetch-history": "node scripts/fetch/fetch-history.ts",
    "fetch-terrain": "node scripts/fetch/fetch-terrain.ts",
    "fetch-gtfs": "node scripts/fetch/fetch-gtfs.ts",
    "fetch-nid": "node scripts/fetch/fetch-nid.ts",
    "bake-gtfs": "node scripts/bake/bake-gtfs.ts",
    "bake-monuments": "node scripts/bake/bake-monuments.ts",
    "bake-wiki": "node scripts/bake/bake-wiki.ts",
    "lint": "biome lint src scripts",
    "format": "biome format --write src scripts",
    "lod2": "node scripts/bake/lod2.ts",
    "bake-scenes": "node scripts/bake/bake-scenes.ts",
    "test-tilecodec": "node scripts/test/test-tilecodec.ts"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.20.5",
    "@types/three": "^0.160.0",
    "geotiff": "^3.0.5",
    "jpeg-js": "^0.4.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
